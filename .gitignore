*.class
*.jar
*.war
*.ear

# Node / Frontend artifacts
**/node_modules/
**/dist/
**/build/
.pnp
.pnp.js
*.tsbuildinfo

# IDEs and Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example

# Local backups and private uploaded media
/backups/
/backend/storage/
/storage/*
!/storage/products/
/storage/products/**
!/storage/products/**/
!/storage/products/**/*.jpg
!/storage/products/**/*.png
!/storage/products/**/*.webp

# Local inspection output and office temporary files
*.inspect.ndjson
~$*
~*.tmp

# Portable project launchers
!/.gitignore
!/run-backend.bat
!/run-frontend.bat
