{
  "module": "voucher", "version": 1,
  "description": "Voucher tổng quát FIXED/PERCENT/SHIPPING: điều kiện, làm tròn, giữ và hoàn lượt. PERCENT dùng đơn vị 0,01%; tiền VND nguyên. Không mô phỏng mã đặc biệt BWF50K, parser BigDecimal, danh mục hoặc đồng thời. used=-1, cap=-1, maximum=-1 và minimum=-1 biểu diễn null theo từng trường; active=-1 biểu diễn null (không phải false); expiry=-1 đã hết hạn, 0 đúng thời điểm, 1 tương lai, 2 không có hạn.",
  "backend_sha256": {
    "VoucherService.java": "38a8896012f1247037d38921b344f929469632cb4bf856330f3bd2c81ee9f54c",
    "VndAmount.java": "a810c77b94281d9cd2795445f06c3ca2001230878ac31233c0ce61eda0bd4042"
  },
  "fields": {
    "action": [0,3,0], "kind": [0,3,1], "total": [-1,10000000000,100000],
    "value": [-1,10000000000,1000], "cap": [-2,10000000000,-1],
    "minimum": [-2,10000000000,0], "used": [-2,2147483647,0],
    "maximum": [-2,2147483647,-1], "active": [-1,1,1], "expiry": [-1,2,1]
  },
  "locals": {"discount":0,"shipping_discount":0,"shipping_fee":0,"final_total":0,"used_after":0},
  "outputs": ["discount","shipping_discount","shipping_fee","final_total","used_after"],
  "target": "discount > 0 and kind == 1",
  "rules": [
    {"set":"used_after","value":"0 if used == -1 else used"},
    {"when":"action >= 2","set":"used_after","value":"max(used_after - action + 1, 0)"},
    {"when":"action >= 2","return":0},
    {"when":"total < 0 or total > 9999999999 or kind > 2","return":1},
    {"when":"cap < -1 or cap > 9999999999 or minimum < -1 or minimum > 9999999999 or used_after < 0 or maximum < -1","return":1},
    {"when":"maximum != -1 and maximum < used_after","return":1},
    {"when":"kind == 1 and (value <= 0 or value > 10000)","return":1},
    {"when":"kind != 1 and (value < 0 or value > 9999999999)","return":1},
    {"when":"kind == 2 and value == 0","return":1},
    {"when":"active == 0 or expiry < 0 or used_after == 2147483647 or (maximum != -1 and used_after >= maximum)","return":2},
    {"when":"minimum != -1 and total < minimum","return":3},
    {"when":"kind == 0","set":"discount","value":"min(value, total)"},
    {"when":"kind == 1","set":"discount","value":"total * value // 10000"},
    {"when":"kind == 1 and cap != -1","set":"discount","value":"min(discount, cap)"},
    {"when":"kind == 1 and discount == 0","return":4},
    {"set":"discount","value":"min(discount, total)"},
    {"set":"shipping_fee","value":"0 if total == 0 or total >= 1000000 else 30000"},
    {"when":"kind == 2 and shipping_fee == 0","return":5},
    {"when":"kind == 2","set":"shipping_discount","value":"min(value, shipping_fee)"},
    {"set":"final_total","value":"total - discount"},
    {"when":"action == 1","set":"used_after","value":"used_after + 1"}
  ],
  "requirements": [
    ["REQ-V1","Kiểm tra cấu hình và miền tiền trước khi áp dụng."],
    ["REQ-V2","Từ chối inactive, hết hạn hoặc hết lượt."],
    ["REQ-V3","Đạt tiền đơn tối thiểu mới được giảm."],
    ["REQ-V4","Phần trăm làm tròn xuống VND, áp dụng cap, không vượt tiền hàng."],
    ["REQ-V5","Voucher vận chuyển không áp dụng khi phí đã bằng 0."],
    ["REQ-V6","Giữ tăng lượt sau thành công; hoàn có sàn 0, không tự coi release là idempotent."]
  ],
  "cases": [
    {"id":"TC-V1","req":"REQ-V4","title":"Giảm cố định bị chặn bởi tiền hàng","input":{"kind":0,"value":200000},"expected":{"code":0,"values":[100000,0,30000,0,0]}},
    {"id":"TC-V2","req":"REQ-V4","title":"Phần trăm 12,34% làm tròn xuống","input":{"total":10001,"value":1234},"expected":{"code":0,"values":[1234,0,30000,8767,0]}},
    {"id":"TC-V3","req":"REQ-V2","title":"Hết lượt bị từ chối","input":{"used":10,"maximum":10},"expected":{"code":2,"values":[0,0,0,0,10]}},
    {"id":"TC-V4","req":"REQ-V5","title":"Đơn miễn phí không dùng voucher shipping","input":{"kind":2,"total":1000000,"value":30000},"expected":{"code":5,"values":[0,0,0,0,0]}},
    {"id":"TC-V5","req":"REQ-V6","title":"Giữ thành công tăng lượt","input":{"action":1,"used":9,"maximum":10},"expected":{"code":0,"values":[10000,0,30000,90000,10]}},
    {"id":"TC-V6","req":"REQ-V6","title":"Hoàn hai lần có sàn 0","input":{"action":3,"used":1,"active":0,"expiry":-1},"expected":{"code":0,"values":[0,0,0,0,0]}},
    {"id":"TC-V7","req":"REQ-V3","title":"Chưa đạt mức tối thiểu","input":{"minimum":100001},"expected":{"code":3,"values":[0,0,0,0,0]}},
    {"id":"TC-V8","req":"REQ-V1","title":"Phần trăm vượt 100%","input":{"value":10001},"expected":{"code":1,"values":[0,0,0,0,0]}},
    {"id":"TC-V9","req":"REQ-V4","title":"Mức giảm sau làm tròn bằng 0","input":{"total":1,"value":1},"expected":{"code":4,"values":[0,0,0,0,0]}},
    {"id":"TC-V10","req":"REQ-V2","title":"Biên bộ đếm INT_MAX","input":{"used":2147483647},"expected":{"code":2,"values":[0,0,0,0,2147483647]}},
    {"id":"TC-V11","req":"REQ-V5","title":"Hỗ trợ shipping bị giới hạn bởi phí","input":{"kind":2,"value":40000},"expected":{"code":0,"values":[0,30000,30000,100000,0]}},
    {"id":"TC-V12","req":"REQ-V4","title":"Giảm phần trăm có cap","input":{"cap":5000},"expected":{"code":0,"values":[5000,0,30000,95000,0]}}
  ]
}
