  },
  "locals": {
    "paid": 0,
    "held": 0,
    "earned": 0,
    "available": 0,
    "discount": 0
  },
  "outputs": [
    "available",
    "discount",
    "earned",
    "held"
  ],
  "target": "discount > 0",
  "rules": [
    {
      "set": "paid",
      "value": "paid + (max(total_0 - shipping_0, 0) if recognized_0 and not cancelled_0 else 0)"
    },
    {
      "set": "held",
      "value": "held + (max(used_0, 0) if not cancelled_0 else 0)"
    },
    {
      "set": "paid",
      "value": "paid + (max(total_1 - shipping_1, 0) if recognized_1 and not cancelled_1 else 0)"
    },
    {
      "set": "held",
      "value": "held + (max(used_1, 0) if not cancelled_1 else 0)"
    },
    {
      "set": "paid",
      "value": "paid + (max(total_2 - shipping_2, 0) if recognized_2 and not cancelled_2 else 0)"
    },
    {
      "set": "held",
      "value": "held + (max(used_2, 0) if not cancelled_2 else 0)"
    },
    {
      "set": "paid",
      "value": "paid + (max(total_3 - shipping_3, 0) if recognized_3 and not cancelled_3 else 0)"
    },
    {
      "set": "held",
      "value": "held + (max(used_3, 0) if not cancelled_3 else 0)"
    },
    {
      "set": "earned",
      "value": "paid // 10000"
    },
    {
      "set": "available",
      "value": "max(earned - held, 0)"
    },
    {
      "when": "points < 0 or points > 1000000 or points > available or points > merchandise // 1000",
      "return": 1
    },
    {
      "set": "discount",
      "value": "points * 100"
    }
  ],
  "requirements": [
    [
      "REQ-L1",
      "Chỉ tiền được ghi nhận và đơn không hủy mới sinh điểm."
    ],
    [
      "REQ-L2",
      "Trừ phí vận chuyển, sàn tiền tính điểm bằng 0."
    ],
    [
      "REQ-L3",
      "Cộng tiền đủ điều kiện trước khi chia lấy phần nguyên cho 10.000."
    ],
    [
      "REQ-L4",
      "Trừ điểm đang giữ/đã dùng trên mọi đơn chưa hủy, kể cả chưa thanh toán."
