    [
      "REQ-L5",
      "Từ chối điểm âm, vượt 1.000.000, vượt số dư hoặc vượt 10% tiền hàng."
    ],
    [
      "REQ-L6",
      "Mỗi điểm đổi được 100 VND; đổi 0 điểm hợp lệ."
    ]
  ],
